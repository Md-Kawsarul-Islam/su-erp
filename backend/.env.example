# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Production database (Render will normally provide DATABASE_URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional local database variables (used when DATABASE_URL is not set)
DB_NAME=su_erp
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Comma-separated frontend origins, e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
